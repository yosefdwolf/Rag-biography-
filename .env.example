# Copy to .env and fill in. Never commit .env.

# Required. From https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-key>

# Local: leave blank to use a SQLite file (local.db).
# Railway: set to ${{Postgres.DATABASE_URL}} in the service's Variables.
DATABASE_URL=

# Required. The password for uploads, runs and questions (they are refused while unset). Share it with your grader.
APP_PASSWORD=

# Optional tuning (defaults shown).
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
TOP_K=6
MIN_SIMILARITY=0.30
